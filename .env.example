# ------------------------------------------------------------------
# LAVCENTER — Variables de entorno (PLANTILLA, sin valores reales)
# Copia este archivo como .env.local para desarrollo y configura las
# mismas variables en Vercel: Project → Settings → Environment Variables.
#
# - NEXT_PUBLIC_*: públicas, se incrustan en el build. Después de
#   cambiarlas en Vercel hay que volver a desplegar.
# - Sin prefijo: secretas, solo se leen en el servidor.
#   NUNCA escribas valores reales en este archivo: se sube al repositorio.
# ------------------------------------------------------------------

# URL pública definitiva (canonical, Open Graph, sitemap, robots). Sin "/" final.
# Si no se define, se usa https://www.lavcenter.cl.
NEXT_PUBLIC_SITE_URL=https://www.lavcenter.cl

# --- Contacto -------------------------------------------------------
# Opcionales: el número oficial ya está en src/config/site.ts.
# Defínelas solo si quieres usar otro número sin tocar el código.
# WhatsApp en formato internacional, solo dígitos, sin "+" ni espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Teléfono para llamadas (solo dígitos) y cómo se muestra en pantalla.
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_PHONE_DISPLAY=

# --- Formulario de contacto: Resend (secretas) -----------------------
# Si falta alguna, el formulario abre WhatsApp con el mensaje armado.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Correo que recibe las solicitudes.
CONTACT_EMAIL_TO=servicio@lavcenter.cl
# Remitente: el dominio lavcenter.cl debe estar verificado en Resend.
CONTACT_EMAIL_FROM=LAVCENTER <servicio@lavcenter.cl>

# --- Google reCAPTCHA v3 ----------------------------------------------
# Clave de sitio (pública) y clave secreta (solo servidor).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Puntaje mínimo aceptado (0.0 a 1.0). Por defecto 0.5.
RECAPTCHA_MIN_SCORE=0.5

# --- Medición (dejar vacío lo que no se use) ------------------------
# Opción A (recomendada): Google Tag Manager. Si se define, NO se carga gtag.js
# directo; GA4 y Google Ads se configuran dentro del contenedor GTM.
NEXT_PUBLIC_GTM_ID=GTM-MJRMCF64
# Opción B: gtag.js directo (solo si NO se usa GTM).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Etiquetas de conversión de Google Ads (parte después de "/" en send_to).
NEXT_PUBLIC_GOOGLE_ADS_LABEL_WHATSAPP=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PHONE=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_FORM=
